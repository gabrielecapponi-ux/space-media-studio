{
  "schema_version": 1,
  "id": "cinema-blender-20261103",
  "project": "Space Media Studio",
  "scope": "Original refined identity/packaging and project-design demonstration films, plus independently framed native portrait versions. They replace historical service-brand and service-funding in the current homepage.",
  "commercial_status": "Original fictional, non-commissioned concepts. No existing client, commission, grant approval or business result is claimed.",
  "method": "Authored Blender geometry, curved and flat typography, materials, light, perspective camera and periodic deterministic pose animation. Offline EEVEE renders; these are actual 3D film pixels, not live interactive GLBs and not AI generated video.",
  "scenes": {
    "brand": {
      "concept": "FORMA / Coffee roasters identity",
      "authored_geometry": "Hollow double-wall coffee tin with actual visible interior and metal rolled rim, independent removable spun lid with concentric rings, custom curved physical type, dimensional f. signature and cotton identity card stock. Lid and identity card assemble in a continuous original four-second loop."
    },
    "funding": {
      "concept": "Dall’idea al progetto / Space Progetti",
      "authored_geometry": "Citron-backed folio, eighteen bound sheet edges, three independently animated printed planning pages and connected AZIENDE/APS/ASD section tabs. Graphite cover presents original IDEA/PIANO/IMPATTO planning diagram. A project-design concept, not an announcement of an open call."
    }
  },
